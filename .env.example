# Copy to .env and fill in real values. Never commit .env.

# MySQL connection string used by Prisma
DATABASE_URL=mysql://user:password@localhost:3306/konzani

# Signs the session cookie (HMAC-SHA256). Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional: Sentry error reporting (leave empty to disable)
SENTRY_DSN=
