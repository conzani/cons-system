{
	"name": "system",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "prisma migrate dev && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"seed": "tsx prisma/seed.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^26.1.1",
		"autoprefixer": "^10.5.4",
		"postcss": "^8.5.22",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
		"@prisma/client": "^6.0.0",
		"bcrypt": "^6.0.0",
		"prisma": "^6.0.0"
	}
}
