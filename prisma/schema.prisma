  receiptNumber   String    @unique @map("receipt_number")
  purchaseOrderId BigInt    @map("purchase_order_id")
  warehouseId     BigInt    @map("warehouse_id")
  receiptDate     DateTime  @map("receipt_date")
  documentId      BigInt?   @map("document_id")
  notes           String?   @db.Text
  receivedBy      BigInt?   @map("received_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                 BigInt @id @default(autoincrement())
  publicId           String @unique @map("public_id")
  receiptId          BigInt @map("receipt_id")
  purchaseOrderItemId BigInt @map("purchase_order_item_id")
  quantity           Float
  unitCost           BigInt @map("unit_cost")
  createdAt          DateTime @default(now()) @map("created_at")

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_items")
}