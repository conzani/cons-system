// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                BigInt    @id @default(autoincrement())
  publicId          String    @unique @map("public_id")
  name              String
  registrationNumber String?   @map("registration_number")
  taxId             String?   @map("tax_id")
  address           String?
  phone             String?
  email             String?
  website           String?
  logo              String?
  status            String?   @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@map("company")
}

model Branch {
  id          BigInt    @id @default(autoincrement())
  publicId    String    @unique @map("public_id")
  name        String
  description String?
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  departments Department[]
  users       User[]
  employees   Employee[]

  @@map("branch")
}

model Department {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @map("public_id")
  branchId    BigInt   @map("branch_id")
  name        String
  type        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  branch      Branch   @relation(fields: [branchId], references: [id])
  users       User[]
  employees   Employee[]

  @@map("departments")
}

model User {
  id             BigInt    @id @default(autoincrement())
  publicId       String    @unique @map("public_id")
  roleId         BigInt    @map("role_id")
  departmentId   BigInt?   @map("department_id")
  branchId       BigInt?   @map("branch_id")
  firstname      String    @map("firstname")
  lastname       String    @map("lastname")
  email          String    @unique
  phone          String?   @unique
  password       String
  changepassword String?   @map("changepassword")
  status         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  role           Role      @relation(fields: [roleId], references: [id])
  department     Department? @relation(fields: [departmentId], references: [id])
  branch         Branch?   @relation(fields: [branchId], references: [id])
  userRoles      UserRole[]
  documents      Document[]
  uploadedVersions DocumentVersion[] @relation("DocumentUploader")
  approvedVersions DocumentVersion[] @relation("VersionApprover")
  createdFolders  DocumentFolder[]
  documentPermissions DocumentPermission[]
  sharedDocuments DocumentShare[] @relation("DocumentSharer")
  receivedShares  DocumentShare[] @relation("DocumentRecipient")
  documentComments DocumentComment[]
  documentActivityLogs DocumentActivityLog[]
  employee         Employee?
  approvedTimesheets Timesheet[] @relation("TimesheetApprover")
  tenderCommunicationsSender TenderCommunication[] @relation("CommSender")
  tenderCommunicationsRecipient TenderCommunication[] @relation("CommRecipient")
  tenderRequirements TenderRequirement[]
  tenderWorkflowStages TenderWorkflowStage[]
  managedTenders   Tender[]

  @@map("users")
}

model UserRole {
  id        BigInt   @id @default(autoincrement())
  roleId    BigInt   @map("role_id")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([roleId, userId])
  @@map("user_role")
}

model Role {
  id               BigInt             @id @default(autoincrement())
  publicId         String             @unique @map("public_id")
  name             String
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")
  users            User[]
  userRoles        UserRole[]
  rolesPermissions RolesPermission[]
  documentPermissions DocumentPermission[]

  @@map("roles")
}

model RolesPermission {
  id           BigInt   @id @default(autoincrement())
  rolesId      BigInt   @map("roles_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")
  role         Role     @relation(fields: [rolesId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([rolesId, permissionId])
  @@map("roles_permissions")
}

model Permission {
  id               BigInt             @id @default(autoincrement())
  publicId         String             @unique @map("public_id")
  name             String             @unique
  action           String
  module           String
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  rolesPermissions RolesPermission[]

  @@map("permissions")
}

// Document Management System Models

model Document {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @map("public_id")
  documentNumber   String?   @map("document_number")
  title            String
  description      String?   @db.Text
  fileName         String    @map("file_name")
  storedName       String    @map("stored_name")
  fileExtension    String    @map("file_extension")
  mimeType         String    @map("mime_type")
  fileSize         BigInt    @map("file_size")
  checksum         String
  version          Int       @default(1)
  status           String    @default("Draft")
  documentTypeId   BigInt?   @map("document_type_id")
  folderId         BigInt?   @map("folder_id")
  ownerId          BigInt    @map("owner_id")
  employeeId       BigInt?   @map("employee_id")
  projectId        BigInt?   @map("project_id")
  siteId           BigInt?   @map("site_id")
  tenderId         BigInt?   @map("tender_id")
  storagePath      String?   @map("storage_path")
  referenceNumber  String?   @map("reference_number")
  revisionNumber   String?   @map("revision_number")
  confidentiality  String?   @default("Internal")
  expiryDate       DateTime? @map("expiry_date")
  reviewDate       DateTime? @map("review_date")
  retentionPeriod  String?   @map("retention_period")
  keywords         String?   @db.Text
  ocrText          String?   @map("ocr_text") @db.Text
  isLocked         Boolean   @default(false) @map("is_locked")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  isTemplate       Boolean   @default(false) @map("is_template")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  documentType     DocumentType?    @relation(fields: [documentTypeId], references: [id])
  folder           DocumentFolder?  @relation(fields: [folderId], references: [id])
  owner            User             @relation(fields: [ownerId], references: [id])
  employee         Employee?        @relation("EmployeeDocuments", fields: [employeeId], references: [id])
  project          Project?        @relation(fields: [projectId], references: [id])
  site             Site?           @relation(fields: [siteId], references: [id])
  tender           Tender?         @relation(fields: [tenderId], references: [id])
  versions         DocumentVersion[]
  permissions      DocumentPermission[]
  shares           DocumentShare[]
  comments         DocumentComment[]
  tags             DocumentTag[]
  links            DocumentLink[]
  activityLogs     DocumentActivityLog[]

  @@map("documents")
}

model DocumentVersion {
  id            BigInt    @id @default(autoincrement())
  documentId    BigInt    @map("document_id")
  versionNumber Int       @map("version_number")
  fileName      String    @map("file_name")
  checksum      String
  uploadedBy    BigInt    @map("uploaded_by")
  uploadDate    DateTime  @default(now()) @map("upload_date")
  changeSummary String?   @map("change_summary")
  approvedBy    BigInt?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader      User      @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  approver      User?     @relation("VersionApprover", fields: [approvedBy], references: [id])

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentFolder {
  id             BigInt    @id @default(autoincrement())
  parentFolderId BigInt?   @map("parent_folder_id")
  name           String
  description    String?
  createdBy      BigInt    @map("created_by")
  projectId      BigInt?   @map("project_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  parentFolder   DocumentFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  subFolders     DocumentFolder[]  @relation("FolderHierarchy")
  creator        User              @relation(fields: [createdBy], references: [id])
  documents      Document[]

  @@map("document_folders")
}

model DocumentType {
  id          BigInt     @id @default(autoincrement())
  publicId    String     @unique @map("public_id")
  name        String
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  documents   Document[]

  @@map("document_types")
}

model DocumentPermission {
  id           BigInt   @id @default(autoincrement())
  documentId   BigInt   @map("document_id")
  userId       BigInt?  @map("user_id")
  roleId       BigInt?  @map("role_id")
  canView      Boolean  @default(false) @map("can_view")
  canDownload  Boolean  @default(false) @map("can_download")
  canEdit      Boolean  @default(false) @map("can_edit")
  canDelete    Boolean  @default(false) @map("can_delete")
  canShare     Boolean  @default(false) @map("can_share")
  canApprove   Boolean  @default(false) @map("can_approve")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id])
  role         Role?    @relation(fields: [roleId], references: [id])

  @@unique([documentId, userId, roleId])
  @@map("document_permissions")
}

model DocumentShare {
  id           BigInt    @id @default(autoincrement())
  documentId   BigInt    @map("document_id")
  sharedBy     BigInt    @map("shared_by")
  sharedWith   BigInt    @map("shared_with")
  sharedDate   DateTime  @default(now()) @map("shared_date")
  expiryDate   DateTime? @map("expiry_date")
  accessType   String    @map("access_type")
  downloadCount Int      @default(0) @map("download_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharer       User      @relation("DocumentSharer", fields: [sharedBy], references: [id])
  recipient    User      @relation("DocumentRecipient", fields: [sharedWith], references: [id])

  @@map("document_shares")
}

model DocumentComment {
  id          BigInt    @id @default(autoincrement())
  documentId  BigInt    @map("document_id")
  comment     String    @db.Text
  commentedBy BigInt    @map("commented_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  commenter   User      @relation(fields: [commentedBy], references: [id])

  @@map("document_comments")
}

model DocumentTag {
  id          BigInt    @id @default(autoincrement())
  documentId  BigInt    @map("document_id")
  tag         String
  createdAt   DateTime  @default(now()) @map("created_at")

  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, tag])
  @@map("document_tags")
}

model DocumentLink {
  id           BigInt   @id @default(autoincrement())
  documentId   BigInt   @map("document_id")
  module       String
  entityId     BigInt   @map("entity_id")
  relationship String
  createdAt    DateTime @default(now()) @map("created_at")

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_links")
}

model DocumentActivityLog {
  id          BigInt    @id @default(autoincrement())
  publicId    String    @unique @map("public_id")
  documentId  BigInt    @map("document_id")
  userId      BigInt    @map("user_id")
  action      String
  ipAddress   String?   @map("ip_address")
  device      String?
  oldValue    String?   @map("old_value")
  newValue    String?   @map("new_value")
  createdAt   DateTime  @default(now()) @map("created_at")

  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@map("document_activity_logs")
}

// HR Module Models

model Employee {
  id                BigInt    @id @default(autoincrement())
  publicId          String    @unique @map("public_id")
  employeeNumber    String    @unique @map("employee_number")
  userId            BigInt?   @unique @map("user_id")
  departmentId      BigInt?   @map("department_id")
  positionId        BigInt?   @map("position_id")
  branchId          BigInt?   @map("branch_id")
  firstname         String
  lastname          String
  email             String?   @unique
  phone             String?
  dateOfBirth       DateTime? @map("date_of_birth")
  gender            String?
  maritalStatus     String?   @map("marital_status")
  nationality       String?
  idType            String?   @map("id_type") // National ID, License, Passport
  idNumber          String?   @map("id_number") // The actual ID number
  taxId             String?   @map("tax_id")
  paymentMethod     String?   @map("payment_method") // Bank, Mobile Money, Cash
  paymentMethodName String?   @map("payment_method_name") // Bank name, Mobile Money provider name
  accountName       String?   @map("account_name") // Account holder name
  accountNumber     String?   @map("account_number") // Bank account number or Mobile Money number
  employmentType    String?   @map("employment_type")
  employmentStatus  String    @default("Active") @map("employment_status")
  paymentType       String    @default("Monthly") @map("payment_type") // Hourly, Daily, Monthly
  hourlyRate        BigInt?   @map("hourly_rate") // For hourly employees
  dailyRate         BigInt?   @map("daily_rate") // For daily employees
  monthlySalary     BigInt?   @map("monthly_salary") // For monthly employees
  hireDate          DateTime  @map("hire_date")
  terminationDate   DateTime? @map("termination_date")
  terminationReason String?  @map("termination_reason")
  address           String?   @db.Text
  emergencyContact  String?   @map("emergency_contact")
  emergencyPhone    String?   @map("emergency_phone")
  profilePicture    String?  @map("profile_picture")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  user              User?       @relation(fields: [userId], references: [id])
  department        Department? @relation(fields: [departmentId], references: [id])
  branch            Branch?     @relation(fields: [branchId], references: [id])
  documents         Document[]  @relation("EmployeeDocuments")
  timesheets        Timesheet[]
  payrollRecords    Payroll[]
  tenderTeamMembers TenderTeamMember[]

  @@map("employees")
}

model Timesheet {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  employeeId      BigInt    @map("employee_id")
  projectId       BigInt?   @map("project_id")
  siteId          BigInt?   @map("site_id")
  date            DateTime
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  regularHours    Decimal   @default(0) @map("regular_hours") @db.Decimal(10, 2)
  overtimeHours   Decimal   @default(0) @map("overtime_hours") @db.Decimal(10, 2)
  breakMinutes    Int       @default(0) @map("break_minutes")
  description     String?   @db.Text
  attendanceStatus String?  @default("Present") @map("attendance_status") // Present, Late, Absent, Sick, Leave, Holiday
  approvedBy      BigInt?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  status          String    @default("Pending") // Pending, Approved, Rejected
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  employee      Employee  @relation(fields: [employeeId], references: [id])
  approver      User?     @relation("TimesheetApprover", fields: [approvedBy], references: [id])

  @@map("timesheets")
}

model Payroll {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  employeeId      BigInt    @map("employee_id")
  payPeriodStart  DateTime  @map("pay_period_start")
  payPeriodEnd    DateTime  @map("pay_period_end")
  paymentType     String    @map("payment_type") // Hourly, Daily, Monthly
  salaryType      String?   @default("Gross") @map("salary_type") // Gross or Net
  taxPercentage   Float?    @map("tax_percentage")
  pensionAmount   BigInt?   @map("pension_amount")
  insuranceAmount BigInt?    @map("insurance_amount")
  regularHours    Decimal   @default(0) @map("regular_hours") @db.Decimal(10, 2)
  overtimeHours   Decimal   @default(0) @map("overtime_hours") @db.Decimal(10, 2)
  regularPay      BigInt    @default(0) @map("regular_pay")
  overtimePay     BigInt    @default(0) @map("overtime_pay")
  allowances      BigInt    @default(0)
  deductions      BigInt    @default(0)
  bonuses         BigInt    @default(0)
  netPay          BigInt    @map("net_pay")
  grossPay        BigInt    @map("gross_pay")
  taxAmount       BigInt    @map("tax_amount")
  status          String    @default("Draft") // Draft, Calculated, Approved, Paid
  paidAt          DateTime? @map("paid_at")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("payroll")
}

// Tender and Bid Management Models

model Tender {
  id                BigInt    @id @default(autoincrement())
  publicId          String    @unique @map("public_id")
  tenderNumber      String    @unique @map("tender_number")
  title             String
  client            String
  tenderType        String?   @map("tender_type")
  source            String?
  description       String?   @db.Text
  location          String?
  value             BigInt?
  closingDate       DateTime  @map("closing_date")
  submissionDate    DateTime? @map("submission_date")
  status            String    @default("New")
  progress          Int       @default(0)
  bidManagerId      BigInt?   @map("bid_manager_id")
  projectId         BigInt?   @map("project_id")
  siteId            BigInt?   @map("site_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  bidManager        User?     @relation(fields: [bidManagerId], references: [id])
  project           Project?  @relation(fields: [projectId], references: [id])
  site              Site?     @relation(fields: [siteId], references: [id])
  documents         Document[]
  teamMembers       TenderTeamMember[]
  requirements       TenderRequirement[]
  communications     TenderCommunication[]
  workflowStages    TenderWorkflowStage[]

  @@map("tenders")
}

model TenderTeamMember {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  tenderId        BigInt    @map("tender_id")
  employeeId      BigInt    @map("employee_id")
  role            String
  responsibilities String?   @db.Text
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  status          String    @default("Active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("tender_team_members")
}

model TenderRequirement {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  tenderId        BigInt    @map("tender_id")
  category        String
  item            String
  description     String?   @db.Text
  status          String    @default("Pending")
  dueDate         DateTime? @map("due_date")
  completedAt     DateTime? @map("completed_at")
  assignedTo      BigInt?   @map("assigned_to")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  assignee        User?     @relation(fields: [assignedTo], references: [id])

  @@map("tender_requirements")
}

model TenderCommunication {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  tenderId        BigInt    @map("tender_id")
  subject         String
  message         String    @db.Text
  senderId        BigInt    @map("sender_id")
  recipientId     BigInt?   @map("recipient_id")
  isInternal      Boolean   @default(true) @map("is_internal")
  status          String    @default("Unread")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  sender          User      @relation("CommSender", fields: [senderId], references: [id])
  recipient       User?     @relation("CommRecipient", fields: [recipientId], references: [id])

  @@map("tender_communications")
}

model TenderWorkflowStage {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  tenderId        BigInt    @map("tender_id")
  stageName       String    @map("stage_name")
  stageOrder      Int       @map("stage_order")
  status          String    @default("Pending")
  completedAt     DateTime? @map("completed_at")
  completedBy     BigInt?   @map("completed_by")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tender          Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  completedByUser User?     @relation(fields: [completedBy], references: [id])

  @@map("tender_workflow_stages")
}

model Project {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  projectNumber   String    @unique @map("project_number")
  name            String
  description     String?   @db.Text
  client          String?
  location        String?
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  value           BigInt?
  status          String    @default("Active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenders         Tender[]
  documents       Document[]

  @@map("projects")
}

model Site {
  id              BigInt    @id @default(autoincrement())
  publicId        String    @unique @map("public_id")
  siteNumber      String    @unique @map("site_number")
  name            String
  location        String?
  client          String?
  status          String    @default("Active")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  progress        Int       @default(0)
  siteManagerId   BigInt?   @map("site_manager_id")
  value           BigInt?
  projectType     String?   @map("project_type")
  description     String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenders         Tender[]
  documents       Document[]

  @@map("sites")
}
